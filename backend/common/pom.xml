<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.recruit</groupId>
    <artifactId>recruit-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>common</artifactId>
  <description>公共基础件：Result/错误码/traceId/雪花ID/Redis Key 契约（不放业务逻辑）</description>
  <dependencies>
    <!-- Spring Boot 基础能力（Bean 容器、自动配置、日志门面等）。不引入 web starter，避免 common 反向绑定 Web 运行环境。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- 仅使用 Jackson 注解（如 @JsonInclude），不引入完整 databind，保持公共模块轻量。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>

    <!-- SLF4J 日志 API：UserContextFilter、GlobalExceptionHandler 通过它输出日志。 -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Spring MVC 的注解与异常类型（@RestControllerAdvice、ResponseEntity、BindException 等）。
         只依赖 spring-web，不引入 spring-boot-starter-web，业务服务自行决定是否做 Web 应用。 -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>

    <!-- Servlet API：UserContextFilter 继承 OncePerRequestFilter 需要它。
         scope=provided：运行时由 Tomcat 等容器提供，不能打进业务 jar，否则会与容器版本冲突。 -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Jakarta Bean Validation API：GlobalExceptionHandler 捕获 ConstraintViolationException 需要该类型。
         这里只引 API，具体实现（Hibernate Validator）由业务服务的 web starter 提供。 -->
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>

    <!-- 测试依赖：JUnit 5、AssertJ、Mockito、spring-test（MockHttpServletRequest 等）。
         scope=test 表示只在编译和运行测试时可见，不会传递给依赖 common 的业务服务。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
