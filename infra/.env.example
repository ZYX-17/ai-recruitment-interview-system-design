# AI 服务（B）本地/Docker 环境示例
# 复制为 infra/.env 后按实际情况修改；真实 .env 不入库。

# MySQL（recruit_ai / recruit_resume / recruit_file）
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=recruit_ai

# Redis
REDIS_HOST=host.docker.internal
REDIS_PORT=6379

# LLM 路由：云端优先 → 本地 OpenAI 兼容模型 → Mock（可选）
AI_MODE=auto
AI_ALLOW_MOCK=true
AI_TIMEOUT_SECONDS=30
AI_LOCAL_TIMEOUT_SECONDS=60

# 云端 LLM（OpenAI 兼容；DeepSeek flash/fast）
CLOUD_BASE_URL=https://api.deepseek.com/v1
# TODO: 后续补充 DeepSeek API Key（当前留空；AI_MODE=auto 会自动走本地 Ollama）
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-chat

# 本地 LLM（OpenAI 兼容；Ollama 跑在开发电脑上，不是 VM）
# 容器内通过 host.docker.internal 访问宿主机的 11434
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
LOCAL_LLM_API_KEY=EMPTY
# 有 GPU 时可切 vLLM（同一个 local_llm.py）：
# LOCAL_LLM_BASE_URL=http://host.docker.internal:8000/v1
# LOCAL_LLM_MODEL=Qwen2.5-7B-Instruct-AWQ

# 内部 worker
AI_WORKER_URL=http://ai-worker:8001
MINERU_WORKER_URL=http://mineru-worker:8002

# 服务间内部令牌（file-service /internal/**）；生产环境必须改成随机值
INTERNAL_TOKEN=dev-internal-token

# MQ / Outbox：false 时 Outbox 只落库不投递，消费者也不启动（最小档）
MQ_ENABLED=true
# 统一事件交换机（topic，routingKey=eventType）
EVENTS_EXCHANGE=recruit.events
OUTBOX_POLL_MS=5000
OUTBOX_BATCH_SIZE=50

# resume-service embedding / ES
# ai-service 与 resume-service 在不同 compose 网络，resume 侧通过宿主机端口访问 ai-worker
RESUME_AI_WORKER_URL=http://host.docker.internal:8001
EMBED_BATCH_SIZE=32
# 开发/演示可降级本地 mock；生产建议 false
EMBED_FALLBACK_MOCK=true
# ES IK 未安装时自动回退 standard
ES_ANALYZER=ik_max_word
# 检索：es / mysql-like；ES 失败时按 SEARCH_FALLBACK 自动降级
SEARCH_MODE=es
SEARCH_FALLBACK=true
SEARCH_RECALL_SIZE=200
SEARCH_RRF_K=60

# 能力开关（mock 优先，后续切真实）
ASR_MOCK=true
EMBED_MODE=mock
MINERU_MOCK=true
PARSER_MODE=mock

# mineru-worker 消费与内部服务地址（容器内用 host.docker.internal 访问宿主机）
MINERU_QUEUE=mineru.resume-received
RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RESUME_SERVICE_URL=http://host.docker.internal:8084
FILE_SERVICE_URL=http://host.docker.internal:8087
MINERU_UPLOADER_ID=0
