# ============================================================================
# 招聘面试系统 · 环境变量示例
# 复制为 infra/.env 后按实际情况修改；真实 .env 不入库。
# A = 成员 A（auth / interview / notify / api-gateway）
# B = 成员 B（ai / resume / file）
# ============================================================================

# ---------- 共享：MySQL ----------
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root

# ---------- 共享：Redis / RabbitMQ / Nacos / MinIO ----------
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_HOST=host.docker.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

NACOS_ADDR=host.docker.internal:8848
NACOS_AUTH_TOKEN=SecretKey012345678901234567890123456789012345678901234567890123456789
NACOS_AUTH_IDENTITY_KEY=recruit
NACOS_AUTH_IDENTITY_VALUE=recruit

MINIO_ENDPOINT=http://host.docker.internal:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=recruit

# ---------- A：JWT 密钥（RS256） ----------
# 私钥只挂 auth-service；网关/其他服务只挂公钥。文件权限 600，禁止入库。
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt-public.pem

# ---------- A：内部接口与 CORS（P3 起由网关/服务读取） ----------
# 服务间调用头 /internal/**，30 天轮换；不得与任何前端变量共用
INTERNAL_TOKEN=change-me-internal-token
# 网关 CORS 白名单，逗号分隔；禁止 * + credentials（§11 D13）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088

# ---------- A：种子管理员与冒烟 ----------
# admin 初始密码由 seed 读取，首次登录强制改密；smoke.sh 用 SMOKE_PASSWORD 登录
SEED_ADMIN_PASSWORD=
SMOKE_PASSWORD=

# ---------- A：SMTP（notify） ----------
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ---------- B：AI 服务 ----------
MYSQL_DB=recruit_ai

# LLM 档位（OpenAI 兼容；切档只改 base-url + model）
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL=Qwen2.5-7B-Instruct-AWQ
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-chat
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen3:1.7b

# 内部 worker
AI_WORKER_URL=http://ai-worker:8001
MINERU_WORKER_URL=http://mineru-worker:8002

# 能力开关（mock 优先，后续切真实）
ASR_MOCK=true
EMBED_MODE=mock
MINERU_MOCK=true
